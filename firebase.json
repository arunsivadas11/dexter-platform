{
  "hosting": {
    "public": "dexter-app/build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "dexter-backend",
          "region": "asia-south1"
        }
      },
      {
        "source": "/aboutme",
        "destination": "/aboutme/index.html"
      },
      {
        "source": "/aboutme/**",
        "destination": "/aboutme/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}